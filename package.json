{
  "name": "codex-limit-auto-reset",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.12",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "dev:cli": "node --env-file-if-exists=.env src/cli.ts",
    "dev:reset": "node --env-file-if-exists=.env src/reset.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:cli": "node --env-file-if-exists=.env src/cli.ts",
    "start:reset": "node --env-file-if-exists=.env src/reset.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "execa": "10.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
